# 复制为 keystore.properties 并填入你的真实值。
# keystore.properties 已被 .gitignore 排除，不会入库 —— 请勿把它提交到任何仓库。
#
# 生成签名密钥（PKCS12，RSA 4096，有效期 10000 天）：
#   keytool -genkeypair -v -keystore handy-agent.jks \
#     -alias handy-agent -keyalg RSA -keysize 4096 -validity 10000 \
#     -storetype PKCS12

storeFile=/absolute/path/to/handy-agent.jks
storePassword=
keyAlias=handy-agent
keyPassword=
