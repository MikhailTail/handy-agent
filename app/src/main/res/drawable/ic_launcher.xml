<?xml version="1.0" encoding="utf-8"?>
<!--
  Handy Agent 图标 —— 甲骨文「手」，三指即三点。

  设计意图：甲骨文的「手」本就是一只手的象形。这里让三个点**直接当三根伸出的手指**，
  于是「点数」与「思考中」的双关重合，字形和含义长在一起，不靠外加装饰。
  朱红底反白，是一枚印章，呼应主题的「纸·墨·印」；末指用深色，在红底上留出那一点异色。

  Vector Drawable 不支持 <line>/<circle>/<rect rx>，全部展开成等价的 path：
  线段 → M/L；圆 → 两段半圆弧；圆角矩形 → 四段圆弧。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- 朱红印章底：x=88 y=88 w=848 h=848 rx=190 -->
    <path
        android:fillColor="#96442B"
        android:pathData="M278,88 L746,88 A190,190 0 0 1 936,278 L936,746 A190,190 0 0 1 746,936 L278,936 A190,190 0 0 1 88,746 L88,278 A190,190 0 0 1 278,88 Z" />

    <!-- 三根手指的连接线（指根 → 掌） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F6F0E1"
        android:strokeWidth="62"
        android:strokeLineCap="round"
        android:pathData="M378,404 L430,520" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F6F0E1"
        android:strokeWidth="62"
        android:strokeLineCap="round"
        android:pathData="M512,378 L512,520" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F6F0E1"
        android:strokeWidth="62"
        android:strokeLineCap="round"
        android:pathData="M646,404 L594,520" />

    <!-- 三根指尖（中间最长）—— 这就是那「三个点」 -->
    <path
        android:fillColor="#F6F0E1"
        android:pathData="M320,352 a58,58 0 1,0 116,0 a58,58 0 1,0 -116,0 Z" />
    <path
        android:fillColor="#F6F0E1"
        android:pathData="M448,322 a64,64 0 1,0 128,0 a64,64 0 1,0 -128,0 Z" />
    <path
        android:fillColor="#2A1410"
        android:pathData="M588,352 a58,58 0 1,0 116,0 a58,58 0 1,0 -116,0 Z" />

    <!-- 掌 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F6F0E1"
        android:strokeWidth="62"
        android:strokeLineJoin="round"
        android:pathData="M330,560 Q512,500 694,560 Q728,730 512,790 Q296,730 330,560 Z" />

    <!-- 腕 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#F6F0E1"
        android:strokeWidth="62"
        android:strokeLineCap="round"
        android:pathData="M512,788 L512,878" />
</vector>
