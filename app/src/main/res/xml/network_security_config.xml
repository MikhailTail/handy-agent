<?xml version="1.0" encoding="utf-8"?>
<!--
  只放行 loopback 的明文 HTTP。

  为什么需要：本地服务监听 127.0.0.1，WebView 用 http://127.0.0.1:<port>/ 加载前端 ——
  Android 9 起默认禁止明文流量，不放行会直接 ERR_CLEARTEXT_NOT_PERMITTED。

  为什么只放行这两个域名：本地服务与 WebView 必须同源，同源才不需要注入 baseUrl；
  而 cc-haha 前端的 h5AccessPolicy 只对 loopback 请求免 token。把范围限死在
  127.0.0.1 / localhost，其余流量仍强制 TLS，不因为这个特例降低整体安全性。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
