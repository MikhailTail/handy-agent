# 复制为 keystore.properties 并填入你的真实值。
# keystore.properties 已被 .gitignore 排除，不会入库 —— 请勿把它提交到任何仓库。
#
# 生成签名密钥：
#   keytool -genkeypair -v -keystore pocket-agent-release.jks \
#     -alias pocket-agent -keyalg RSA -keysize 4096 -validity 10000

storeFile=/absolute/path/to/pocket-agent-release.jks
storePassword=
keyAlias=pocket-agent
keyPassword=
