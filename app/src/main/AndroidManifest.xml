<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- WebView 要访问本机的 127.0.0.1 服务，即使是 loopback 也需要 INTERNET。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      全盘文件访问 —— 用户明确选择的能力，Agent 要能读写手机的任意位置
      （照片、下载、文档），这正是它存在的意义。

      代价与约束：
      - Android 11+ 需要在「设置 → 应用 → 特殊应用权限 → 所有文件访问权限」手动开启，
        Environment.isExternalStorageManager() 为 false 时文件工具会失败，
        所以在能力体检页要有引导（尚未实现）。
      - Play 商店对 MANAGE_EXTERNAL_STORAGE 审核极严（基本只给文件管理器类应用），
        侧载分发不受影响。
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:name=".HandyApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Handy">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Handy"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          无障碍服务 —— mobile use 的唯一能力来源。

          走的是**语义路径**（按控件序号操作），对应 cc-haha 的 macOS 实现
          （AX 元素句柄），而不是 Windows 那套像素坐标。Android 的
          AccessibilityNodeInfo 天然属于前者。

          必须由用户在「设置 → 无障碍」手动开启；Android 13+ 侧载包还需先
          「允许受限设置」。开启之前工具的调用会被拒绝并提示用户，不会静默失败。
        -->
        <service
            android:name=".mobile.MobileBridgeImpl"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
